# Copy this file to .env.local and fill in only the services you use.
# .env.local is ignored by Git. Never commit real keys or paste them into docs.

# Optional: override the default same-site image/audio paths with a separate media host.
# VITE_WORD_ATLAS_MEDIA_BASE_URL=

# OpenAI Images API (current gen_images.py backend)
ATLAS_OPENAI_API_KEY=
OPENAI_API_KEY=
ATLAS_IMAGE_PROVIDER=openai
ATLAS_IMAGE_BASE_URL=https://api.openai.com/v1
# ATLAS_IMAGE_MODEL=gpt-image-2.5-flare

# ElevenLabs audio pipeline
ATLAS_ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY=
ATLAS_ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ATLAS_ELEVENLABS_MODEL=eleven_v4_turbo

# Cloudflare Workers AI + FLUX image backend
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ATLAS_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4

# New API OpenAI-compatible image backend
ATLAS_NEWAPI_API_KEY=
ATLAS_NEWAPI_BASE_URL=
# Set ATLAS_IMAGE_PROVIDER=newapi and ATLAS_IMAGE_MODEL=gpt-image-1 to use it.

# Optional local image conversion tool
ATLAS_CWEBP=

# Optional ElevenLabs voice overrides
# ATLAS_ELEVENLABS_UK_VOICE_ID=
# ATLAS_ELEVENLABS_US_VOICE_ID=
# ATLAS_ELEVENLABS_EX_VOICE_ID=
# ATLAS_ELEVENLABS_EX2_VOICE_ID=
