{
  "name": "word-atlas",
  "version": "1.0.0",
  "type": "module",
  "description": "An illustrated vocabulary atlas with shared progress across IELTS and TOEFL learning paths.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check:atlas && npm run check:curricula && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test src/**/*.test.ts",
    "check:readings": "node scripts/check-readings.mjs",
    "check:curricula": "node scripts/check-curricula.mjs",
    "check:atlas": "node scripts/check-atlas.mjs",
    "test:pipeline": "python -m unittest discover -s tests -p test_atlas_pipeline.py",
    "test:media": "python -m unittest discover -s tests -p test_media_pipeline.py",
    "atlas:prepare": "python scripts/atlas/prepare_ecdict_batch.py",
    "atlas:text": "python scripts/atlas/gen_text.py",
    "atlas:append": "python scripts/atlas/append_atlas.py",
    "atlas:word-pack": "python scripts/atlas/run_word_pack.py",
    "atlas:tags": "python scripts/import_ecdict_exam_tags.py",
    "build:atlas": "python3 scripts/atlas/build_atlas.py",
    "render:cards": "node scripts/render-cards.mjs",
    "pack:public": "python3 scripts/package_public.py --out ../开源发布/word-atlas",
    "format": "prettier --write src vite.config.ts scripts/*.mjs package.json tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  },
  "private": true,
  "license": "MIT"
}
